<?php
require_once '../server/session.php';
require_once '../server/language.php';
require_once '../classes/complaints.php';
require_once '../classes/notifications.php';

if (!isLoggedIn() || empty($_SESSION['user_data']['is_admin'])) {
    header('Location: interface.php');
    exit();
}

$db          = getDB();
$adminId     = (int)$_SESSION['user_id'];
$complaintSvc = new Complaints($db);
$notifSvc     = new Notifications($db);

$flashSuccess = '';
$flashError   = '';

// -----------------------------------------------------------------
// POST handlers
// -----------------------------------------------------------------
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $action = $_POST['action'] ?? '';

    switch ($action) {

        case 'approve_verification':
            $verif_id = (int)($_POST['verif_id'] ?? 0);
            $verif_user_id = (int)($_POST['verif_user_id'] ?? 0);
            if ($verif_id && $verif_user_id) {
                try {
                    $stmt = $db->prepare("UPDATE student_verifications SET status='approved', updated_at=datetime('now') WHERE id=?");
                    $stmt->execute([$verif_id]);
                    $stmt = $db->prepare("UPDATE users SET is_student_verified=1 WHERE id=?");
                    $stmt->execute([$verif_user_id]);
                    $notifSvc->create($verif_user_id, 'Student Verification Approved',
                        'Your student verification has been approved. You now have student status on ForsaDrive.', 'success', 'settings.php');
                    $flashSuccess = 'Verification approved.';
                } catch (PDOException $e) {
                    $flashError = 'Failed to approve verification.';
                    error_log('admin approve_verification: ' . $e->getMessage());
                }
            }
            break;

        case 'reject_verification':
            $verif_id      = (int)($_POST['verif_id'] ?? 0);
            $verif_user_id = (int)($_POST['verif_user_id'] ?? 0);
            if ($verif_id && $verif_user_id) {
                try {
                    $stmt = $db->prepare("UPDATE student_verifications SET status='rejected', updated_at=datetime('now') WHERE id=?");
                    $stmt->execute([$verif_id]);
                    $notifSvc->create($verif_user_id, 'Student Verification Rejected',
                        'Your student verification request was not approved. Please contact support if you believe this is an error.', 'danger', 'settings.php');
                    $flashSuccess = 'Verification rejected.';
                } catch (PDOException $e) {
                    $flashError = 'Failed to reject verification.';
                    error_log('admin reject_verification: ' . $e->getMessage());
                }
            }
            break;

        case 'resolve_complaint':
            $complaint_id   = (int)($_POST['complaint_id'] ?? 0);
            $admin_note     = trim($_POST['admin_note'] ?? '');
            if ($complaint_id) {
                if ($complaintSvc->updateStatus($complaint_id, 'resolved', $admin_note)) {
                    $flashSuccess = 'Complaint resolved.';
                } else {
                    $flashError = 'Failed to resolve complaint.';
                }
            }
            break;

        case 'suspend_user':
            $target_id = (int)($_POST['target_user_id'] ?? 0);
            if ($target_id && $target_id !== $adminId) {
                try {
                    $db->prepare("UPDATE users SET suspended=1 WHERE id=?")->execute([$target_id]);
                    $flashSuccess = 'User suspended.';
                } catch (PDOException $e) {
                    $flashError = 'Failed to suspend user.';
                }
            } else {
                $flashError = 'Cannot suspend yourself.';
            }
            break;

        case 'unsuspend_user':
            $target_id = (int)($_POST['target_user_id'] ?? 0);
            if ($target_id) {
                try {
                    $db->prepare("UPDATE users SET suspended=0 WHERE id=?")->execute([$target_id]);
                    $flashSuccess = 'User unsuspended.';
                } catch (PDOException $e) {
                    $flashError = 'Failed to unsuspend user.';
                }
            }
            break;
    }

    // PRG pattern: redirect to same page with active tab preserved
    $tab = htmlspecialchars($_POST['active_tab'] ?? 'overview');
    header('Location: admin.php?tab=' . $tab . ($flashSuccess ? '&ok=1' : '&err=1'));
    exit();
}

// Flash from redirect
if (isset($_GET['ok']))  $flashSuccess = 'Action completed successfully.';
if (isset($_GET['err'])) $flashError   = 'Action failed. Please try again.';

// -----------------------------------------------------------------
// Data queries
// -----------------------------------------------------------------

// Stats
$totalUsers    = 0;
$totalRides    = 0;
$totalBookings = 0;
$openComplaints = 0;
try {
    $totalUsers     = (int)$db->query("SELECT COUNT(*) FROM users")->fetchColumn();
    $totalRides     = (int)$db->query("SELECT COUNT(*) FROM rides")->fetchColumn();
    $totalBookings  = (int)$db->query("SELECT COUNT(*) FROM bookings")->fetchColumn();
    $openComplaints = (int)$db->query("SELECT COUNT(*) FROM complaints WHERE status='open'")->fetchColumn();
} catch (PDOException $e) {
    error_log('admin stats: ' . $e->getMessage());
}

// Pending verifications
$pendingVerifications = [];
try {
    $stmt = $db->prepare(
        "SELECT sv.*, u.username, u.email
         FROM student_verifications sv
         JOIN users u ON u.id = sv.user_id
         WHERE sv.status = 'pending'
         ORDER BY sv.created_at DESC"
    );
    $stmt->execute();
    $pendingVerifications = $stmt->fetchAll(PDO::FETCH_ASSOC);
} catch (PDOException $e) {
    error_log('admin pendingVerifications: ' . $e->getMessage());
}

// Open complaints
$openComplaintsList = $complaintSvc->getAllComplaints('open');

// All users (last 50)
$allUsers = [];
try {
    $stmt = $db->prepare(
        "SELECT id, username, email, is_driver, is_student, is_student_verified, suspended, score, created_at
         FROM users
         ORDER BY created_at DESC
         LIMIT 50"
    );
    $stmt->execute();
    $allUsers = $stmt->fetchAll(PDO::FETCH_ASSOC);
} catch (PDOException $e) {
    error_log('admin allUsers: ' . $e->getMessage());
}

// Active tab from GET param
$activeTab = in_array($_GET['tab'] ?? '', ['overview','verifications','complaints','users'])
    ? $_GET['tab']
    : 'overview';

$pageTitle = 'Admin Panel';
require_once '../include/header.php';
require_once '../include/sidebar.php';

function dateStr(string $d): string {
    return !empty($d) ? date('d M Y', strtotime($d)) : '—';
}
?>

